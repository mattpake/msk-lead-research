# --- App ---
# development | production
APP_ENV=development
# Base URL this API is reachable at
API_BASE_URL=http://localhost:8000
# CORS allow-list origin for the Next.js client
FRONTEND_ORIGIN=http://localhost:3000
# SQLAlchemy async database URL (SQLite file for v1)
DATABASE_URL=sqlite+aiosqlite:///./msk_leads.db
# structlog level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- LLM (research, scoring, email drafts) ---
# openai | anthropic
LLM_PROVIDER=openai
# Required before any pipeline run (validated at run start, not boot)
LLM_API_KEY=
# Cheap-tier model for research/scoring calls
LLM_MODEL=gpt-4.1-mini
# Stronger model for client-facing email drafts
LLM_EMAIL_MODEL=gpt-4.1
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT_SECONDS=60

# --- Google Places (New) — https://places.googleapis.com/v1 ---
# Required before discovery runs
GOOGLE_PLACES_API_KEY=
# Results per Text Search page (API max: 20)
PLACES_PAGE_SIZE=20
# Cost guard: pages fetched per query (2 x 20 = 40 results max per query)
PLACES_MAX_PAGES_PER_QUERY=2
# Politeness delay between paginated calls
PLACES_REQUEST_DELAY_MS=200

# --- Firecrawl (https://api.firecrawl.dev/v2) ---
# Required before research runs
FIRECRAWL_API_KEY=
FIRECRAWL_TIMEOUT_MS=120000
# Scrape cache window (7 days) — halves credit spend on retries
FIRECRAWL_MAX_AGE_MS=604800000

# --- Google Sheets export (optional in v1; CSV export always works) ---
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./secrets/service-account.json
# Leave empty to disable Sheets export
GOOGLE_SHEETS_SPREADSHEET_ID=

# --- Pipeline guardrails ---
# 4 verticals x 8 target cities = 32
MAX_DISCOVERY_QUERIES_PER_RUN=32
MAX_RESEARCH_CONCURRENCY=3
# Score >= 70 -> suggested accept; < 40 -> suggested reject
SCORE_AUTO_ACCEPT_THRESHOLD=70
SCORE_REJECT_THRESHOLD=40
